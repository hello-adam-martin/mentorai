# Copy to ~/.hermes/.env and fill in. NEVER commit real secrets.
# config.yaml reads these via ${VAR} substitution; the gateway reads them directly.

# --- Model provider key (match config.yaml model.provider) ---
ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...

# --- Telegram channel ---
# Create a bot with @BotFather, copy the token. (Confirm the exact key name on the
# Hermes Telegram setup page: docs/user-guide/messaging/telegram.)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Comma-separated NUMERIC Telegram user IDs allowed to talk to / approve for the agent.
# Get yours from @userinfobot. This is your approver allow-list.
TELEGRAM_ALLOWED_USERS=
# Restrict the gateway overall. Do NOT use GATEWAY_ALLOW_ALL_USERS=true in production.
GATEWAY_ALLOWED_USERS=

# --- Mentor guardrails plugin ---
# The plugin reads your model's Governance layer LIVE. It finds the model by walking up from
# the working directory; set this if you start Hermes somewhere else (e.g. cron/subagents):
# MENTOR_MODEL_DIR=~/path/to/your-business-folder
# Where the append-only audit log is written (JSONL):
MENTOR_AUDIT_LOG=~/.hermes/logs/mentor-audit.jsonl
